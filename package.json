{
  "name": "mac-clean-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server/index.js & vite",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "app": "electron .",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.macclean.studio",
    "productName": "MacClean Studio",
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.22.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.21",
    "electron": "^30.5.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^5.3.1"
  }
}
